function render(tool){const t=tools[tool];$("toolTitle").textContent=t.title;$("toolIntro").textContent=t.intro;$("fields").replaceChildren(...t.fields.map(field));document.querySelectorAll(".modebar a").forEach(a=>a.classList.toggle("active",a.dataset.tool===tool));$("toolSearch").value="";$("suggestions").style.display="none";updateMeta(t);calculate(tool)}
