"sip":{
title:"SIP Calculator — Monthly Investment",
meta:"Project the future value of a monthly SIP using an assumed annual return and investment period.",
intro:"Project the future value of a regular monthly investment. The return is an assumption, not a guaranteed investment outcome.",
keywords:["sip","sip calculator","sip calculator india","systematic investment plan","monthly investment","mutual fund sip","5000 sip","10000 sip","sip calculator hindi","एसआईपी कैलकुलेटर"],
fields:[
