{id:"sipRate",label:"Assumed annual return (%)",type:"number",value:"12",min:"-99.99",max:"100",step:"0.01"},
{id:"sipYears",label:"Investment period (years)",type:"number",value:"10",min:"0.01",step:"0.01"},
{id:"sipTiming",label:"Investment timing",type:"select",options:[["end","End of each month"],["begin","Beginning of each month"]]}
],
calc(){
