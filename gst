<script>
"use strict";
(function(){
const $=id=>document.getElementById(id), money=x=>{const n=Number(x);return Number.isFinite(n)?new Intl.NumberFormat("en-IN",{style:"currency",currency:"INR",minimumFractionDigits:2,maximumFractionDigits:2}).format(n):"—"}, pct=x=>{const n=Number(x);return Number.isFinite(n)?n.toFixed(2)+"%":"—"}, num=id=>Number($(id)?.value);
function slab(income,bands){let tax=0,prev=0;for(const [cap,rate] of bands){if(income<=prev)break;const top=Math.min(income,cap);if(top>prev)tax+=(top-prev)*rate;prev=cap;if(income<=cap)break}return tax}
const tools={
"income-tax":{
title:"Income Tax Calculator — India (Tax Year 2026–27 / AY 2026–27)",
meta:"Estimate Indian income tax for Tax Year 2026–27 under the Income Tax Act, 2025 or AY 2026–27 under the Income Tax Act, 1961, using ordinary slab-rate income and the stated assumptions.",
intro:"A transparent estimator for ordinary slab-rate income. Select the applicable tax period and regime. The calculation includes the applicable standard deduction, Section 87A rebate for AY 2026–27 or Section 156 rebate for Tax Year 2026–27, surcharge, relevant marginal relief and 4% health and education cess within the stated scope.",
keywords:["income tax","income tax calculator","tax calculator","itr","salary tax","income tax calculator india","tax calculator india","new tax regime","old tax regime","tax year 2026 27","ay 2026 27","87a","surcharge","marginal relief","income tax kitna","salary par tax","salary par tax kitna","12 lakh tax","12.75 lakh salary tax","income tax calculator hindi","new tax regime calculator 2026","old tax regime calculator 2026","income tax slab 2026","tax on 10 lakh salary","tax on 15 lakh salary","tax on 20 lakh salary","इनकम टैक्स कैलकुलेटर","इनकम टैक्स कितना","salary tax calculator hindi"],
fields:[
{id:"taxPeriod",label:"Tax period",type:"select",options:[["ty2026","Tax Year 2026–27 (Income Tax Act, 2025)"],["ay2026","AY 2026–27 (Income Tax Act, 1961)"]]},
{id:"taxSalary",label:"Annual salary / pension income (₹)",type:"number",value:"1200000",min:"0",step:"0.01"},
{id:"taxOther",label:"Other normal slab-rate income (₹)",type:"number",value:"0",min:"0"},
{id:"taxDed",label:"Other eligible deductions under the selected regime (₹)",type:"number",value:"0",min:"0",step:"0.01"},
{id:"taxRegime",label:"Tax regime",type:"select",options:[["new","New regime (default)"],["old","Old regime"]]},
{id:"taxAge",label:"Age attained during the applicable tax year (years)",type:"number",value:"35",min:"0",max:"120",step:"1"},
{id:"taxResident",label:"Residential status",type:"select",options:[["resident","Resident individual"],["nonresident","Non-resident individual"]]}
],
calc(){
const period=$("taxPeriod").value,salary=num("taxSalary"),other=num("taxOther"),enteredDed=num("taxDed"),age=num("taxAge"),reg=$("taxRegime").value,res=$("taxResident").value;
const standard=Math.min(salary,reg==="new"?75000:50000);
const deductions=Math.min(enteredDed, Math.max(0,salary+other-standard));
const totalIncome=Math.max(0,salary+other-standard-deductions);
let baseTax;
if(reg==="new"){
baseTax=slab(totalIncome,[[400000,0],[800000,.05],[1200000,.10],[1600000,.15],[2000000,.20],[2400000,.25],[Infinity,.30]]);
}else{
const basic=age>=80?500000:age>=60?300000:250000;
baseTax=slab(totalIncome,[[basic,0],[500000,.05],[1000000,.20],[Infinity,.30]]);
}
let rebate=0,rebateType="none";
if(res==="resident"&&reg==="new"&&totalIncome<=1200000){rebate=Math.min(baseTax,60000);rebateType="Section 87A rebate";}
if(res==="resident"&&reg==="old"&&totalIncome<=500000){rebate=Math.min(baseTax,12500);rebateType="Section 87A rebate";}
let taxAfterRebate=Math.max(0,baseTax-rebate);
let marginalRelief=0;
// Marginal relief for the new-regime Section 87A threshold above ₹12 lakh.
if(res==="resident"&&reg==="new"&&totalIncome>1200000){
const excess=totalIncome-1200000;
if(taxAfterRebate>excess)marginalRelief=taxAfterRebate-excess;
}
const taxAfterRelief=Math.max(0,taxAfterRebate-marginalRelief);
let surchargeRate=0;
if(totalIncome>50000000)surchargeRate=reg==="new"?.25:.37;
else if(totalIncome>20000000)surchargeRate=.25;
else if(totalIncome>10000000)surchargeRate=.15;
else if(totalIncome>5000000)surchargeRate=.10;
let surcharge=taxAfterRelief*surchargeRate;
const surchargeThreshold=totalIncome>50000000?50000000:totalIncome>20000000?20000000:totalIncome>10000000?10000000:totalIncome>5000000?5000000:0;
if(surchargeRate>0&&surchargeThreshold>0){
let taxAtThreshold;
if(reg==="new")taxAtThreshold=slab(surchargeThreshold,[[400000,0],[800000,.05],[1200000,.10],[1600000,.15],[2000000,.20],[2400000,.25],[Infinity,.30]]);
else{const basic=age>=80?500000:age>=60?300000:250000;taxAtThreshold=slab(surchargeThreshold,[[basic,0],[500000,.05],[1000000,.20],[Infinity,.30]]);}
const thresholdSurcharge=taxAtThreshold*(surchargeThreshold>50000000?(reg==="new"?.25:.37):surchargeThreshold>20000000?.25:surchargeThreshold>10000000?.15:.10);
const cap=(taxAtThreshold+thresholdSurcharge)+(totalIncome-surchargeThreshold);
if(taxAfterRelief+surcharge>cap)surcharge=Math.max(0,cap-taxAfterRelief);
}
const cess=(taxAfterRelief+surcharge)*.04,total=taxAfterRelief+surcharge+cess;
const periodLabel=period==="ty2026"?"Tax Year 2026–27 under the Income Tax Act, 2025":"AY 2026–27 under the Income Tax Act, 1961";
const rebateSection=period==="ty2026"?"Section 156 of the Income Tax Act, 2025":"Section 87A of the Income Tax Act, 1961";
return {
metrics:[
["Taxable income",money(totalIncome)],
["Income tax after rebate / relief",money(taxAfterRelief)],
["Surcharge",money(surcharge)],
["Health & education cess (4%)",money(cess)],
["Estimated total tax",money(total)],
["Tax period",periodLabel]
],
formula:`${periodLabel}. Salary/pension income − applicable standard deduction (${money(standard)}) + other normal-rate income − entered eligible deductions = taxable income. Slab tax → applicable ${rebateSection} rebate/marginal relief → surcharge where applicable → 4% health & education cess.`,
